                      ToolTip="This faction's powers on your power bar, plus what is ticked below: its builders build all its buildings, and those recruit all its units. Your army and buildings stay yours."/>
              <CheckBox x:Name="ChkFacBuilders" Style="{StaticResource Check}" Content="give me two of its builders" Margin="2,7,0,1" IsChecked="True"/>
              <CheckBox x:Name="ChkFacFortress" Style="{StaticResource Check}" Content="give me its fortress (at the camera)" Margin="2,1,0,3"/>
              <Button x:Name="BtnFacRestore" Style="{StaticResource GhostButton}" Content="Back to my own faction's powers" Margin="0,5,0,0" Padding="10,7" FontSize="12"
                      ToolTip="Puts your own faction's powers back on the power bar. Everything you built or recruited stays. Do this before you save a game."/>
              <TextBlock x:Name="StFaction" Text="" Style="{StaticResource CardStatus}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="4" BorderThickness="1" BorderBrush="#7A6328" Background="#2A2214" Padding="10,6" Margin="0,0,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMain}"
                       Text="NEW PAGE. First skirmish tests passed in both games, but not every entry of the lists has been tried. Summons need open, flat ground away from your fortress."/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="2  -  HEROES, UNITS AND BUILDINGS OF EVERY FACTION   (click one: it appears where your camera is looking - pick free, flat ground)" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}" Cursor="Arrow" Padding="12,8,8,8">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel x:Name="FacCats" VerticalAlignment="Center"/>
                <Border x:Name="FacSearchBox" Grid.Column="1" Width="214" Height="30" CornerRadius="3" Background="#1A1610" BorderBrush="#6B5524" BorderThickness="1" Cursor="IBeam" Margin="6,0,4,0"
                        ToolTip="Click here, then type a name. Esc clears it.">
                  <TextBlock x:Name="FacSearchText" Text="🔍  Search all factions" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="9,0,6,0" TextTrimming="CharacterEllipsis"/>
                </Border>
              </Grid>
              <ScrollViewer x:Name="FacScroll" Height="372" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <WrapPanel x:Name="FacItems"/>
              </ScrollViewer>
              <Grid Margin="0,8,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="BtnHeroesFaction" Style="{StaticResource GoldButton}" Content="RECRUIT ALL HEROES OF THIS FACTION" Padding="12,9" FontSize="12"/>
                <Button x:Name="BtnHeroesAll" Grid.Column="1" Style="{StaticResource GhostButton}" Content="RECRUIT ALL HEROES - EVERY FACTION" Padding="12,9" FontSize="12" Margin="8,0,0,0"/>
                <TextBlock x:Name="StSpawn" Grid.Column="2" Text="" Style="{StaticResource CardStatus}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- my heroes page -->
      <Grid x:Name="PageHeroes" Grid.Row="2" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="MY HEROES   (click a hero: the game selects that hero, the camera goes there and this menu closes)" Style="{StaticResource Section}"/>
