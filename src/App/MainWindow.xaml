                <Canvas x:Name="MapCanvas" Width="104" Height="76" ClipToBounds="True">
                  <TextBlock x:Name="MapHint" Text="map" Foreground="#6E6249" FontSize="11" Canvas.Left="40" Canvas.Top="29"/>
                  <Ellipse x:Name="MapRing" Width="26" Height="26" Stroke="#F0D98A" StrokeThickness="1.5" Opacity="0.55" Visibility="Collapsed"/>
                  <Ellipse x:Name="MapDot" Width="10" Height="10" Fill="#FFD54A" Stroke="#3A2A00" StrokeThickness="1" Visibility="Collapsed"/>
                </Canvas>
              </Border>
            </StackPanel>
          </Grid></Border>
          <Border x:Name="CardZoom" Style="{StaticResource Card}" Cursor="Arrow"><StackPanel>
            <Grid x:Name="HeadZoom" Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Extended Zoom" Style="{StaticResource CardTitle}"/><Border x:Name="KeyZoomBox" Style="{StaticResource Key}"><TextBlock x:Name="KeyZoom" Text="F6" Style="{StaticResource KeyText}"/></Border></StackPanel>
                <TextBlock x:Name="StZoom" Text="Off" Style="{StaticResource CardStatus}"/>
              </StackPanel>
              <ToggleButton x:Name="SwZoom" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Zoom-out" Foreground="{StaticResource TextDim}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Slider x:Name="ZoomSlider" Grid.Column="1" Style="{StaticResource GoldSlider}" Minimum="1" Maximum="3" Value="1.6" LargeChange="0.1" SmallChange="0.1" VerticalAlignment="Center" Cursor="Hand"/>
              <TextBlock x:Name="ZoomValue" Grid.Column="2" Text="1.6×" Foreground="{StaticResource GoldLight}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Width="40" TextAlignment="Right" Margin="4,0,8,0"/>
              <Button x:Name="BtnZoomDefault" Grid.Column="3" Style="{StaticResource GhostButton}" Content="Default" Padding="9,5" FontSize="11" ToolTip="Switch extended zoom off and return to the map's normal camera limit"/>
            </Grid>
          </StackPanel></Border>
                  <TextBlock Text="WEATHER  -  visual only" Style="{StaticResource Section}" Margin="3,7,0,5"/>
