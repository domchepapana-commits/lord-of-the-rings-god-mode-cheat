        <!-- column 3 -->
        <StackPanel Grid.Column="4">
          <TextBlock Text="MAP AND CAMERA" Style="{StaticResource Section}"/>
          <Border x:Name="CardReveal" Style="{StaticResource Card}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><TextBlock Text="Reveal Entire Map" Style="{StaticResource CardTitle}"/><Border x:Name="KeyRevealBox" Style="{StaticResource Key}"><TextBlock x:Name="KeyReveal" Text="F5" Style="{StaticResource KeyText}"/></Border></StackPanel>
              <TextBlock x:Name="StReveal" Text="Off" Style="{StaticResource CardStatus}"/>
            </StackPanel>
            <ToggleButton x:Name="SwReveal" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid></Border>
          <Border x:Name="CardGollum" Style="{StaticResource Card}" Cursor="Arrow"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Gollum Tracking" Style="{StaticResource CardTitle}"/><Border x:Name="KeyTrackBox" Style="{StaticResource Key}"><TextBlock x:Name="KeyTrack" Text="F7" Style="{StaticResource KeyText}"/></Border></StackPanel>
              <TextBlock x:Name="StTrack" Text="Off" Style="{StaticResource CardStatus}"/>
              <TextBlock x:Name="StGollum" Text="Switch on to keep Gollum marked on the minimap." Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MinHeight="30" MaxHeight="30"/>
