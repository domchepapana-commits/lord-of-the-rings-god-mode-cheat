<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lord of the Rings God Mode Cheat" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D4AF37"/>
    <SolidColorBrush x:Key="GoldLight" Color="#F0D98A"/>
    <SolidColorBrush x:Key="TextMain" Color="#EFE6CF"/>
    <SolidColorBrush x:Key="TextDim" Color="#A99C7C"/>
    <SolidColorBrush x:Key="CardBg" Color="#211C15"/>
    <SolidColorBrush x:Key="CardLine" Color="#3A3020"/>
    <LinearGradientBrush x:Key="GoldFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F0D98A" Offset="0"/>
      <GradientStop Color="#B8891C" Offset="1"/>
    </LinearGradientBrush>
    <!-- the lettering of the title: gold like the BFME II logo, icy silver like "The Rise of the Witch-king" (colours are set per game in MainWindow.cs) -->
    <LinearGradientBrush x:Key="TitleFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F0D98B" Offset="0"/>
      <GradientStop Color="#E0C06B" Offset="0.45"/>
      <GradientStop Color="#B8891D" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,7,12,7"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#7A6328"/>
          <Setter Property="Background" Value="#272118"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardStatus" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="70"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
              <Border x:Name="Track" CornerRadius="18" Background="#2A241B" BorderBrush="#4A3F2A" BorderThickness="1"/>
              <Border x:Name="Glow" CornerRadius="18" Opacity="0" Background="{StaticResource GoldFill}"/>
              <TextBlock x:Name="OnText" Text="ON" FontSize="10.5" FontWeight="Bold" Foreground="#2A1F08" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" Opacity="0"/>
              <TextBlock x:Name="OffText" Text="OFF" FontSize="10.5" FontWeight="Bold" Foreground="#8C8063" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Ellipse x:Name="Knob" Width="28" Height="28" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="#9A8F76">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Knob" Property="Fill" Value="#FFF8E1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="34" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="OnText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="OffText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="OnText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="OffText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#D4AF37"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1E1607"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" BorderBrush="#F6E6A8" BorderThickness="1" Background="{StaticResource GoldFill}">
              <Border CornerRadius="2" Margin="1" BorderBrush="#55000000" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.87"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" BorderBrush="#6B5524" BorderThickness="1" Background="#1A1610">
              <Border CornerRadius="2" Margin="1" BorderBrush="#3A3020" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#D4AF37"/><Setter TargetName="B" Property="Background" Value="#2A2317"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#3A301C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" Background="#1A1610" BorderBrush="#3A3020" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33291A"/><Setter TargetName="B" Property="BorderBrush" Value="#D4AF37"/><Setter Property="Foreground" Value="#FFF3C4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" Background="#2A1512" BorderBrush="#6E2F28" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#B8382C"/><Setter TargetName="B" Property="BorderBrush" Value="#F08A7E"/><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="#F0B4AC"/>
      <Setter Property="Width" Value="92"/>
    </Style>

    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="3" Padding="12,5" Background="#1A1610" BorderBrush="#4A3F2A" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#D4AF37"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource GoldFill}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="#F6E6A8"/>
                <Setter Property="Foreground" Value="#1E1607"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="6" CornerRadius="3" Background="{StaticResource GoldFill}" VerticalAlignment="Center"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse Width="24" Height="24" Fill="#FFF8E1" Stroke="#B8891C" StrokeThickness="3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GoldSlider" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="#2A241B" BorderBrush="#4A3F2A" BorderThickness="1" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" Height="30">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim scroll bar in the menu's own colours (lists on the All Factions page) -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#1A1610" BorderBrush="#3A3020" BorderThickness="1" CornerRadius="3">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SliderEmpty}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Cursor="Hand" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Border Background="#6B5524" CornerRadius="3" Margin="2"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- a large tile for one hero / unit / building -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="184"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="3" BorderBrush="#4A3F2A" BorderThickness="1" Background="#1A1610" Padding="9,3,6,3">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#D4AF37"/><Setter TargetName="B" Property="Background" Value="#2A2317"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#3A301C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,3,14,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="22" Height="22" CornerRadius="2" Background="#1A1610" BorderBrush="#6B5524" BorderThickness="1.5" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 4,11 L 9,16 L 18,6" Stroke="#1E1607" StrokeThickness="2.6" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GoldFill}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#F6E6A8"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#D4AF37"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D4AF38"/>
      <Setter Property="FontFamily" Value="Palatino Linotype"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="3,1,0,5"/>
    </Style>
    <Style x:Key="Key" TargetType="Border">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="BorderBrush" Value="#6B5524"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#16120C"/>
      <Setter Property="Padding" Value="6,0,6,1"/>
      <Setter Property="Margin" Value="8,1,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GoldLight}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="4,5"/>
      <Setter Property="MinWidth" Value="62"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>  </Window.Resources>

  <Grid x:Name="Root" Width="1180" Margin="12">
    <Grid.LayoutTransform><ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
    <Border CornerRadius="6" BorderThickness="2" BorderBrush="#6B5525">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1D1812" Offset="0"/>
          <GradientStop Color="#15110C" Offset="0.5"/>
          <GradientStop Color="#110E0A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.65" Color="Black"/></Border.Effect>
    </Border>
    <!-- second, inner line of the frame (the games frame their panels with a double border) -->
    <Border CornerRadius="3" BorderThickness="1" BorderBrush="#5A4A22" Margin="5" IsHitTestVisible="False"/>

    <Grid Margin="16,10,16,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- header -->
      <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="AppIcon" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="LORD OF THE RINGS&#10;GOD MODE CHEAT" FontFamily="Palatino Linotype" FontSize="15.5" LineHeight="17" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="{StaticResource TitleFill}">
            <TextBlock.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.9" Color="Black"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="SubtitleText" Text="offline skirmish only" Foreground="{StaticResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
          <Button x:Name="BtnGame" Style="{StaticResource GhostButton}" Padding="10,8" FontSize="12" MinWidth="196" Content="Game  ▾" ToolTip="Choose the game (the trainer also follows whichever game is running)"/>
          <Button x:Name="BtnPatch" Style="{StaticResource GhostButton}" Padding="10,8" FontSize="12" MinWidth="150" Margin="6,0,0,0" Content="Patch  ▾" ToolTip="Patch / version compatibility"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnFactions" Style="{StaticResource ChromeButton}" Width="122" ToolTip="Heroes, units, buildings and powers of every faction; change faction" Content="⚔  ALL FACTIONS" FontSize="12" FontWeight="Bold"/>
          <Button x:Name="BtnSettings" Style="{StaticResource ChromeButton}" Width="100" ToolTip="Hotkeys, menu size, sounds" Content="⚙  SETTINGS" FontSize="12" FontWeight="Bold"/>
          <Button x:Name="BtnHide" Style="{StaticResource ChromeButton}" Width="100" ToolTip="Hide this menu and keep playing (cheats stay active)" Content="HIDE  (F12)" FontSize="12" FontWeight="Bold"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Width="92" ToolTip="Switch all cheats off and close the trainer" Content="✕  CLOSE" FontSize="12" FontWeight="Bold"/>
        </StackPanel>
        <!-- ornamental rule under the title bar -->
        <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-5" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00D4AF39" Offset="0"/>
              <GradientStop Color="#D4AF39" Offset="0.12"/>
              <GradientStop Color="#D4AF39" Offset="0.88"/>
              <GradientStop Color="#00D4AF39" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>

      <!-- status + master -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="372"/></Grid.ColumnDefinitions>
        <Border x:Name="StatusCard" Background="#17130E" BorderBrush="{StaticResource CardLine}" BorderThickness="1" CornerRadius="4" Padding="14,7">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#E57368" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Game status:  " Foreground="{StaticResource TextDim}" FontSize="13.5"/>
                <TextBlock x:Name="StatusText" Text="Game not running" Foreground="{StaticResource TextMain}" FontSize="13.5" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="StatusDetail" Text="Start Rise of the Witch-king and begin a skirmish." Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock x:Name="StatMoney" Text="" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock x:Name="StatCp" Text="" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Right" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="CardMaster" Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#8A6D1F" Background="#2A2214" Margin="0" Padding="14,6,12,6">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MASTER CHEATS" FontFamily="Palatino Linotype" FontSize="17" FontWeight="Bold" Foreground="#F0D98C"/>
              <TextBlock x:Name="StMaster" Text="All cheats on or off together" Style="{StaticResource CardStatus}"/>
            </StackPanel>
            <ToggleButton x:Name="SwMaster" Grid.Column="1" Style="{StaticResource Switch}">
              <ToggleButton.LayoutTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></ToggleButton.LayoutTransform>
            </ToggleButton>
          </Grid>
        </Border>
      </Grid>

      <!-- cheats page -->
      <Grid x:Name="PageCheats" Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- column 1 -->
        <StackPanel>
          <TextBlock Text="ECONOMY AND CONSTRUCTION" Style="{StaticResource Section}"/>
          <Border x:Name="CardMoney" Style="{StaticResource Card}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
