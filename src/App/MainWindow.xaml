                <TextBlock x:Name="StHeroList" Grid.Column="2" Text="" Style="{StaticResource CardStatus}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- footer -->
      <Grid Grid.Row="3" Margin="2,8,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="EventText" Text="Ready." Foreground="{StaticResource TextDim}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="HotkeyHint" Grid.Column="1" Text="F12 shows / hides this menu" Foreground="#6E6249" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </Grid>

      <Popup x:Name="KeyPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
        <Border x:Name="KeyPopupBorder" Background="#211C15" BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="4" Padding="8">
          <WrapPanel x:Name="KeyPopupPanel" Width="420"/>
        </Border>
      </Popup>
      <Popup x:Name="GamePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
        <Border x:Name="GamePopupBorder" Background="#211C15" BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="4" Padding="6">
          <StackPanel x:Name="GamePopupPanel" Width="300"/>
        </Border>
      </Popup>
      <Popup x:Name="PatchPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
        <Border x:Name="PatchPopupBorder" Background="#211C15" BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="4" Padding="6">
          <StackPanel x:Name="PatchPopupPanel" Width="470"/>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</Window>