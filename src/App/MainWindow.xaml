          <TextBlock Text="POWERS AND ABILITIES" Style="{StaticResource Section}" Margin="3,5,0,5"/>
          <Border x:Name="CardPower" Style="{StaticResource Card}" Cursor="Arrow"><StackPanel>
            <Grid x:Name="HeadPower" Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Unlimited Power Points" Style="{StaticResource CardTitle}"/><Border x:Name="KeyPowerBox" Style="{StaticResource Key}"><TextBlock x:Name="KeyPower" Text="F8" Style="{StaticResource KeyText}"/></Border></StackPanel>
                <TextBlock x:Name="StPower" Text="Off" Style="{StaticResource CardStatus}"/>
              </StackPanel>
              <ToggleButton x:Name="SwPower" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,1">
