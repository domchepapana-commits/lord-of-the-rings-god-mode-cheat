              <RadioButton x:Name="Cp5000" GroupName="Cp" Style="{StaticResource Pill}" Content="5,000"/>
              <RadioButton x:Name="Cp10000" GroupName="Cp" Style="{StaticResource Pill}" Content="10,000"/>
