                <RadioButton x:Name="Wx2" GroupName="Wx" Style="{StaticResource Pill}" Content="Rain"/>
                <RadioButton x:Name="Wx3" GroupName="Wx" Style="{StaticResource Pill}" Content="Snow"/>
                <RadioButton x:Name="Wx4" GroupName="Wx" Style="{StaticResource Pill}" Content="Fog"/>
                <RadioButton x:Name="Wx5" GroupName="Wx" Style="{StaticResource Pill}" Content="Storm" Margin="0"/>
              </WrapPanel>
              <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StWeather" Text="Map default" Style="{StaticResource CardStatus}" VerticalAlignment="Center"/>
                <Button x:Name="BtnWeatherDefault" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restore default weather" Padding="9,5" FontSize="11" ToolTip="Put the map's own weather back"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- settings page -->
      <Grid x:Name="PageSettings" Grid.Row="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="372"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="HOTKEYS  -  click a key to change it" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}" Cursor="Arrow">
            <StackPanel>
              <UniformGrid x:Name="HotkeyGrid" Columns="2"/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkHotkeys" Style="{StaticResource Check}" Content="Hotkeys enabled (only while the game is the active window)"/>
                <Button x:Name="BtnResetKeys" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Restore default keys" Padding="10,6" FontSize="11.5"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11" Margin="4,2,4,0"
                     Text="Keys work without Ctrl, Alt or Shift, and only while the game is in front. Function keys and the number-pad keys can be assigned. While a key is assigned here the game's own use of it is replaced in-game (F1–F8 recall saved camera views, F9 hides the interface, F12 takes a screenshot; Ctrl+F1–F8 is not affected). Set a key to None to give it back to the game."/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="MENU AND SOUND" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}" Cursor="Arrow">
            <StackPanel>
              <TextBlock Text="Menu size over the game" Foreground="{StaticResource TextMain}" FontSize="12.5"/>
              <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Slider x:Name="OverlaySlider" Style="{StaticResource GoldSlider}" Minimum="55" Maximum="100" Value="90" LargeChange="5" SmallChange="5" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock x:Name="OverlayValue" Grid.Column="1" Text="90%" Foreground="{StaticResource GoldLight}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Width="46" TextAlignment="Right"/>
              </Grid>
              <CheckBox x:Name="ChkSounds" Style="{StaticResource Check}" Content="Sound cues when a cheat switches"/>
              <CheckBox x:Name="ChkTopmost" Style="{StaticResource Check}" Content="Keep on top when used on the desktop"/>
              <CheckBox x:Name="ChkStartup" Style="{StaticResource Check}" Content="Start with Windows (in the tray)"/>
            </StackPanel>
          </Border>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11" Margin="4,2,4,0"
                     Text="In the game, F12 opens this menu on top of the match without leaving it; the match keeps running and the mouse works in both. Press F12 again, or HIDE, to continue playing."/>
        </StackPanel>
      </Grid>

      <!-- all factions page -->
      <Grid x:Name="PageFactions" Grid.Row="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="1  -  CHOOSE A FACTION" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}" Cursor="Arrow" Padding="10,8,6,2">
            <WrapPanel x:Name="FacList"/>
          </Border>
          <TextBlock Text="CHANGE FACTION  -  POWERS OF EVERY FACTION" Style="{StaticResource Section}" Margin="3,5,0,5"/>
          <Border Style="{StaticResource Card}" Cursor="Arrow">
            <StackPanel>
              <TextBlock x:Name="FacNow" Text="Start a skirmish first." Foreground="{StaticResource TextMain}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <Button x:Name="BtnFacPowers" Style="{StaticResource GoldButton}" Content="USE THIS FACTION'S POWERS" Margin="0,7,0,0" Padding="10,9"
                      ToolTip="Puts this faction's powers on your power bar in the game and unlocks its whole power tree. Powers of other trees stay yours and come back when you switch again."/>
